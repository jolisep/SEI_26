@startuml Playwright AI-Driven Test Architecture
!theme plain
skinparam backgroundColor #FAFAF7
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #334155
skinparam component {
  BackgroundColor #E8F0F5
  BorderColor #315A72
}
skinparam database {
  BackgroundColor #FFF4D6
  BorderColor #A16207
}

database "test-suite.json\n(test cases + locator strategies)" as suite
component "JSON-driven Test Registration" as registration
component "AdaptiveTestRunner" as runner
component "StrategySelector\n(confidence ranking + fallback)" as selector
database "ConfidenceStore\n(persistent strategy confidence)" as confidence
component "RecoveryManager\n(bounded retry + failure artifacts)" as recovery
component "StructuredEventLogger" as logger

suite --> registration : defines tests\nand strategies
registration --> runner : registers tests\nfrom JSON
runner --> selector : resolves each action
selector --> confidence : reads and updates\nstrategy confidence
selector --> recovery : exhausted strategies
runner --> recovery : action failure
recovery --> runner : retries action
registration --> logger : registration events
runner --> logger : execution events
selector --> logger : strategy outcomes
recovery --> logger : recovery events

@enduml
